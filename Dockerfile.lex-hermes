# lex-hermes — Legal Document Automation Platform
# Hermes Agent fork with lexitool + lex_docx native tools + HPSwarm multi-agent
#
# Based on the openclaw-hermes build pattern.
#
# Build:
#   docker build -f Dockerfile.lex-hermes -t lex-hermes .
#
# Run (WebUI dashboard — default):
#   docker run -d --rm \
#     -v /root/.hermes/config.yaml:/root/.hermes/config.yaml:ro \
#     -p 9119:9119 \
#     lex-hermes
#   → Open http://localhost:9119 → Chat tab (gateway auto-started internally)
#
# Run (interactive chat with lex_docx tools):
#   docker run -it --rm \
#     -v ~/.hermes/config.yaml:/root/.hermes/config.yaml:ro \
#     -v $(pwd)/workspace:/workspace \
#     lex-hermes chat
#
# Run (HPSwarm legal project — AGENTS.md in /project auto-loads):
#   docker run -it --rm \
#     -v ~/.hermes/config.yaml:/root/.hermes/config.yaml:ro \
#     -v /path/to/project:/project \
#     -w /project \
#     lex-hermes chat

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore

# Remove PEP 668 marker so pip install works without --break-system-packages
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# ── System Dependencies ──
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    jq \
    libffi-dev \
    nodejs \
    npm \
    python3-dev \
    ripgrep \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-chi-tra \
    tesseract-ocr-eng \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# ── Mirror config (avoids SSL issues with default registries) ──
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.trusted-host pypi.tuna.tsinghua.edu.cn && \
    npm config set registry https://registry.npmmirror.com

WORKDIR /opt/lex-hermes

# ── lexitool (replaces legacy lex-docx) ──
# Installed first so its layers cache independently from hermes-agent.
COPY vendor/lexitool /opt/lexitool
RUN pip install --no-cache-dir /opt/lexitool

# ── hermes-agent fork ──
COPY . /opt/lex-hermes
RUN pip install --no-cache-dir --retries 10 -e ".[web]"

# ── Pre-install edge-tts + ptyprocess so lazy_ensure doesn't hang ──
RUN pip install --no-cache-dir --retries 10 edge-tts ptyprocess

# ── Pre-compile bytecode so imports (docx/lxml/etc.) are fast ──
RUN python3 -c "import docx, lxml" && \
    python3 -m compileall -q -f /usr/local/lib/python3.11/site-packages/ && \
    python3 -m compileall -q -f /opt/lex-hermes/

# ── Claude Code CLI (self-healing) ──
RUN npm install -g @anthropic-ai/claude-code && \
    npm cache clean --force

# ── Web Dashboard ──
RUN cd /opt/lex-hermes/web && \
    npm install --prefer-offline --no-audit && \
    npm run build && \
    npm cache clean --force

# ── TUI (terminal UI for Chat tab PTY) ──
RUN cd /opt/lex-hermes/ui-tui && \
    npm install --prefer-offline --no-audit && \
    npm run build && \
    npm cache clean --force

EXPOSE 9119

# ── Runtime dirs ──
RUN mkdir -p /root/.hermes /workspace /project

# ── Startup script (gateway + dashboard) ──
COPY start-lex-hermes.sh /usr/local/bin/start-lex-hermes.sh
RUN chmod +x /usr/local/bin/start-lex-hermes.sh

# ── Default SOUL.md (writing-focused identity) ──
COPY SOUL.md /root/.hermes/SOUL.md

ENV HERMES_HOME=/root/.hermes
ENV HERMES_DASHBOARD_TUI=1
ENV HERMES_TUI_DIR=/opt/lex-hermes/ui-tui

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/start-lex-hermes.sh"]
