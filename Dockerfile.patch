# Patch build — MINIMAL layers: 1 COPY + 1 RUN
ARG BASE_IMAGE=localhost:6678/lex-hermes:latest
FROM ${BASE_IMAGE}
ENV PIP_BREAK_SYSTEM_PACKAGES=1 PIP_ROOT_USER_ACTION=ignore
WORKDIR /opt/lex-hermes

# Single COPY of everything, then overlay the source tree in RUN
COPY . /tmp/patch_src/

RUN set -eux; \
    cp -a /tmp/patch_src/vendor/lexitool/lexitool/. /opt/lexitool/lexitool/; \
    cp /tmp/patch_src/vendor/lexitool/pyproject.toml /opt/lexitool/; \
    find /tmp/patch_src/tools -maxdepth 1 -type f -name '*.py' -exec cp {} /opt/lex-hermes/tools/ \; ; \
    find /tmp/patch_src/hermes_cli -maxdepth 1 -type f -name '*.py' -exec cp {} /opt/lex-hermes/hermes_cli/ \; ; \
    find /tmp/patch_src/agent -maxdepth 1 -type f -name '*.py' -exec cp {} /opt/lex-hermes/agent/ \; ; \
    find /tmp/patch_src/tui_gateway -maxdepth 1 -type f -name '*.py' -exec cp {} /opt/lex-hermes/tui_gateway/ \; ; \
    for f in run_agent.py model_tools.py toolsets.py hermes_state.py cli.py; do \
      if [ -f "/tmp/patch_src/$f" ]; then cp "/tmp/patch_src/$f" "/opt/lex-hermes/$f"; fi; \
    done; \
    cp /tmp/patch_src/start-lex-hermes.sh /usr/local/bin/; \
    cp /tmp/patch_src/start-lex-hermes.sh /opt/lex-hermes/; \
    cp /tmp/patch_src/SOUL.md /root/.hermes/; \
    mkdir -p /opt/lex-hermes/profiles/; \
    (cp /tmp/patch_src/profiles/*.soul.md /opt/lex-hermes/profiles/ 2>/dev/null || true); \
    rm -rf /tmp/patch_src; \
    pip install --no-cache-dir --no-deps /opt/lexitool; \
    python3 -c "import docx, lxml"; \
    python3 -m compileall -q -f /usr/local/lib/python3.11/site-packages/; \
    python3 -m compileall -q -f /opt/lex-hermes/
