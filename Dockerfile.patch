    cp tests/test_lexitool_ocr_fallback.py /opt/hermes/tests/test_lexitool_ocr_fallback.py; \
    cp tests/test_lexitool_ocr_fallback.py /opt/lex-hermes/tests/test_lexitool_ocr_fallback.py; \
    mkdir -p /opt/hermes/tests/plugins /opt/lex-hermes/tests/plugins; \
    cp tests/plugins/test_backoffice_issue_relay.py /opt/hermes/tests/plugins/test_backoffice_issue_relay.py; \
    cp tests/plugins/test_backoffice_issue_relay.py /opt/lex-hermes/tests/plugins/test_backoffice_issue_relay.py; \
    mkdir -p /opt/hermes/tests/gateway /opt/lex-hermes/tests/gateway; \
    cp tests/gateway/test_status.py /opt/hermes/tests/gateway/test_status.py; \
    cp tests/gateway/test_status.py /opt/lex-hermes/tests/gateway/test_status.py; \
    cp hermes_state.py /opt/hermes/hermes_state.py; \
    \
    find /opt/lexitool/lexitool/__pycache__ -name '*.pyc' -delete 2>/dev/null; \
    find /opt/hermes/vendor/lexitool/lexitool/__pycache__ -name '*.pyc' -delete 2>/dev/null; \
    find "$VENV_LEXITOOL/__pycache__" -name '*.pyc' -delete 2>/dev/null; \
    find /opt/hermes/tools/__pycache__ -name '*.pyc' -delete 2>/dev/null; \
    find /opt/lex-hermes/tools/__pycache__ -name '*.pyc' -delete 2>/dev/null; \
    chmod 644 \
      /opt/hermes/hermes_cli/container_boot.py /opt/lex-hermes/hermes_cli/container_boot.py \
      /opt/hermes/hermes_cli/commands.py /opt/lex-hermes/hermes_cli/commands.py \
      /opt/hermes/hermes_cli/kanban.py /opt/lex-hermes/hermes_cli/kanban.py \
      /opt/hermes/hermes_cli/web_server.py /opt/lex-hermes/hermes_cli/web_server.py \
