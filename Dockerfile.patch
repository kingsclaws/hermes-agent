# Patch build — MINIMAL layers: 1 COPY + 1 RUN
ARG BASE_IMAGE=localhost:6678/lex-hermes:latest
FROM ${BASE_IMAGE}
ENV PIP_BREAK_SYSTEM_PACKAGES=1 PIP_ROOT_USER_ACTION=ignore
WORKDIR /opt/lex-hermes

# Single COPY of everything, then overlay the source tree in RUN
COPY . /tmp/patch_src/

RUN set -eux; \
    cp -a /tmp/patch_src/vendor/lexitool/lexitool/. /opt/lexitool/lexitool/; \
    cp /tmp/patch_src/vendor/lexitool/pyproject.toml /opt/lexitool/; \
    for d in tools hermes_cli agent tui_gateway; do \
      mkdir -p "/opt/lex-hermes/$d"; \
      cp -a "/tmp/patch_src/$d/." "/opt/lex-hermes/$d/"; \
    done; \
    find /opt/lex-hermes/tools /opt/lex-hermes/hermes_cli /opt/lex-hermes/agent /opt/lex-hermes/tui_gateway \
      \( -name '__pycache__' -o -name '*.pyc' \) -exec rm -rf {} +; \
    for f in run_agent.py model_tools.py toolsets.py hermes_state.py hermes_constants.py cli.py; do \
      if [ -f "/tmp/patch_src/$f" ]; then cp "/tmp/patch_src/$f" "/opt/lex-hermes/$f"; fi; \
    done; \
    cp /tmp/patch_src/start-lex-hermes.sh /usr/local/bin/; \
    cp /tmp/patch_src/start-lex-hermes.sh /opt/lex-hermes/; \
    cp /tmp/patch_src/SOUL.md /root/.hermes/; \
    rm -rf /opt/lex-hermes/skills/productivity/ocr-and-documents/ \
      /root/.hermes/skills/productivity/ocr-and-documents/ \
      /opt/lex-hermes/skills/productivity/legal-project-workflow/ \
      /root/.hermes/skills/productivity/legal-project-workflow/; \
    for s in \
      skills/productivity/ocr-and-documents \
      skills/productivity/legal-project-workflow \
      skills/legal/lexitool-operations; do \
      mkdir -p "/opt/lex-hermes/$s" "/root/.hermes/$s"; \
      cp -a "/tmp/patch_src/$s/." "/opt/lex-hermes/$s/"; \
      cp -a "/tmp/patch_src/$s/." "/root/.hermes/$s/"; \
    done; \
    mkdir -p /opt/lex-hermes/profiles/; \
    (cp /tmp/patch_src/profiles/*.soul.md /opt/lex-hermes/profiles/ 2>/dev/null || true); \
    rm -rf /tmp/patch_src; \
    pip install --no-cache-dir --no-deps /opt/lexitool; \
    python3 -c "import docx, lxml"; \
    python3 -m compileall -q -f /usr/local/lib/python3.11/site-packages/; \
    python3 -m compileall -q -f /opt/lex-hermes/
