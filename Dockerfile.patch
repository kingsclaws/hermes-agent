# Minimal patch build — Phase 10 chat room deployment
# docker build -t localhost:6678/lex-hermes:latest -f Dockerfile.patch .
ARG BASE_IMAGE=localhost:6678/lex-hermes:latest
FROM ${BASE_IMAGE}

# Backend Python modules (Phase 10 + low_temperature fix)
COPY hermes_cli/kanban_db.py /opt/hermes/hermes_cli/kanban_db.py
COPY hermes_cli/kanban_legal_swarm.py /opt/hermes/hermes_cli/kanban_legal_swarm.py
COPY hermes_cli/web_server.py /opt/hermes/hermes_cli/web_server.py

# Pre-built frontend
COPY hermes_cli/web_dist/ /opt/hermes/hermes_cli/web_dist/

# Sync to lex-hermes mirror
RUN cp /opt/hermes/hermes_cli/kanban_db.py /opt/lex-hermes/hermes_cli/kanban_db.py && \
    cp /opt/hermes/hermes_cli/kanban_legal_swarm.py /opt/lex-hermes/hermes_cli/kanban_legal_swarm.py && \
    cp /opt/hermes/hermes_cli/web_server.py /opt/lex-hermes/hermes_cli/web_server.py && \
    cp -a /opt/hermes/hermes_cli/web_dist/. /opt/lex-hermes/hermes_cli/web_dist/
